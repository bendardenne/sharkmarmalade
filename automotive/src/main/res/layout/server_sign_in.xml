<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/server_sign_in_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/server_sign_in_form"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintWidth_max="480dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/server_sign_in_logo"
                android:layout_width="96dp"
                android:layout_height="68dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/app_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/server_uri"
                style="@style/LargerTextField"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/server_textfield_hint"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingEnd="56dp"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/server_sign_in_logo" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@id/server_uri"
                app:layout_constraintEnd_toEndOf="@id/server_uri"
                app:layout_constraintTop_toTopOf="@id/server_uri" />

            <RadioGroup
                android:id="@+id/server_type_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/server_uri">

                <RadioButton
                    android:id="@+id/radio_jellyfin"
                    style="@style/ServerTypeTile"
                    android:layout_marginEnd="24dp"
                    android:checked="true"
                    android:drawableTop="@drawable/server_type_jellyfin_icon"
                    android:text="@string/server_type_jellyfin" />

                <RadioButton
                    android:id="@+id/radio_subsonic"
                    style="@style/ServerTypeTile"
                    android:drawableTop="@drawable/server_type_subsonic_icon"
                    android:text="@string/server_type_subsonic" />
            </RadioGroup>

            <Button
                android:id="@+id/submit_server_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="64dp"
                android:background="@color/colorPrimary"
                android:padding="16dp"
                android:text="@string/server_button_label"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/server_type_group" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
